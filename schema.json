{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Achter de Machine weekeditie",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "headlines", "bigStory", "analyses", "cybersecurity", "work", "geopolitics", "thoughtLeaders", "signals", "following", "perspective"],
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "label", "url"],
      "properties": {
        "kind": { "enum": ["Primair", "Onafhankelijk", "Secundair"] },
        "label": { "type": "string", "minLength": 8 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "article": {
      "type": "object", "additionalProperties": false,
      "required": ["section", "title", "intro", "facts", "analysis", "impact", "horizons", "counterScenario", "watch", "sources"],
      "properties": {
        "section": { "type": "string" },
        "title": { "type": "string", "minLength": 12 },
        "intro": { "type": "string", "minLength": 30 },
        "facts": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "analysis": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "impact": { "type": "string", "minLength": 40 },
        "horizons": {
          "type": "object", "additionalProperties": false,
          "required": ["short", "medium", "long"],
          "properties": { "short": { "type": "string" }, "medium": { "type": "string" }, "long": { "type": "string" } }
        },
        "counterScenario": { "type": "string" },
        "watch": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["edition", "publishedAt", "cutoff", "window", "label"],
      "properties": {
        "edition": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "cutoff": { "type": "string" }, "window": { "type": "string" }, "label": { "type": "string" }
      }
    },
    "headlines": {
      "type": "array", "minItems": 8, "maxItems": 15,
      "items": { "type": "object", "additionalProperties": false, "required": ["category", "title"], "properties": { "category": { "type": "string" }, "title": { "type": "string", "minLength": 15 } } }
    },
    "bigStory": {
      "allOf": [
        { "$ref": "#/$defs/article" },
        { "type": "object", "required": ["dek", "readMinutes", "minute", "winners", "losers", "overlooked"], "properties": {
          "dek": { "type": "string", "minLength": 60 }, "readMinutes": { "type": "integer", "minimum": 5 },
          "minute": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
          "winners": { "type": "string" }, "losers": { "type": "string" }, "overlooked": { "type": "string" }
        } }
      ]
    },
    "analyses": { "type": "array", "minItems": 4, "maxItems": 8, "items": { "$ref": "#/$defs/article" } },
    "cybersecurity": { "$ref": "#/$defs/article" }, "work": { "$ref": "#/$defs/article" }, "geopolitics": { "$ref": "#/$defs/article" },
    "thoughtLeaders": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["person", "role", "claim", "status", "assessment", "source"], "properties": {
        "person": { "type": "string" }, "role": { "type": "string" }, "claim": { "type": "string" },
        "status": { "enum": ["Visie", "Voorspelling", "Claim", "Vastgesteld feit"] },
        "assessment": { "type": "string", "minLength": 40 }, "source": { "$ref": "#/$defs/source" }
      } }
    },
    "signals": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "object", "additionalProperties": false, "required": ["title", "explanation"], "properties": { "title": { "type": "string" }, "explanation": { "type": "string" } } } },
    "following": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "perspective": { "type": "array", "minItems": 4, "items": { "type": "string" } }
  }
}
